{
  "name": "adibanking-copilot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "verify:auth": "node --env-file=.env.local scripts/verify-auth.mjs",
    "verify:banking": "node --env-file=.env.local scripts/verify-banking.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-banking.mjs",
    "db:diagnose": "node scripts/diagnose-database.mjs",
    "verify:database-security": "node --env-file=.env.local scripts/audit-database-security.mjs",
    "verify:crud": "node --env-file=.env.local scripts/verify-crud.mjs",
    "verify:analytics": "node --env-file=.env.local scripts/verify-analytics.mjs",
    "verify:assistant": "node --env-file=.env.local scripts/verify-assistant.mjs",
    "test": "jest --runInBand",
    "test:database": "node --test tests/database.test.mjs tests/credit-card.test.mjs tests/session-security.test.mjs tests/revisions.test.mjs tests/activity-logs.test.mjs tests/legacy-users-security.test.mjs",
    "verify:credit-card": "node --env-file=.env.local scripts/verify-credit-card.mjs",
    "verify:logs": "node --env-file=.env.local scripts/verify-logs.mjs",
    "verify:revisions": "node --env-file=.env.local scripts/verify-revisions.mjs",
    "verify:security": "node --env-file=.env.local scripts/verify-security.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "node-fetch": "^3.3.2",
    "openai": "^7.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.5.2",
    "msw": "^3.0.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
